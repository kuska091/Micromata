:root {
  font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  color: #f5f5f5;
  background: #101112;
  font-synthesis: none;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(ellipse at 15% 0%, #24292b 0, transparent 40%),
    #101112;
}

button, input, select { font: inherit; }
button { cursor: pointer; }

.app {
  width: min(1100px, 100%);
  margin: auto;
  padding: 44px 24px 28px;
}

.kopfbereich {
  display: flex;
  align-items: center;
  gap: 20px;
  padding: 20px 0 36px;
}

.marke {
  display: grid;
  place-items: center;
  width: 66px;
  height: 66px;
  flex-shrink: 0;
  border: 1px solid #b89b61;
  border-radius: 14px;
  color: #e6d1a2;
  font-size: 27px;
  font-weight: 800;
}

.marke span { color: #b89b61; }

h1, h2, p { margin-top: 0; }
h1 { margin-bottom: 4px; font-size: clamp(26px, 4vw, 38px); }
h2 { font-size: 22px; margin-bottom: 20px; }
.untertitel { color: #aaa; margin: 0; }

.eyebrow {
  margin-bottom: 7px;
  color: #c3a66b;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 2px;
}

.karte, .willkommen {
  margin-bottom: 20px;
  padding: 26px;
  border: 1px solid #303235;
  border-radius: 17px;
  background: rgba(27, 28, 30, .95);
  box-shadow: 0 12px 36px #0002;
}

.willkommen {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.willkommen h2 { margin-bottom: 6px; }
.willkommen p:last-child { color: #aaa; margin-bottom: 0; }

.tabs { display: flex; gap: 8px; margin-bottom: 26px; }

button {
  padding: 10px 14px;
  border: 1px solid #424448;
  border-radius: 9px;
  background: #242528;
  color: #f4f4f4;
}

button:hover { border-color: #c3a66b; }
.tabs .aktiv, button.primaer {
  background: #b89b61;
  border-color: #b89b61;
  color: #171717;
  font-weight: 700;
}

button.primaer { margin-top: 20px; }
button:disabled { opacity: .35; cursor: not-allowed; }
button.loeschen { color: #ff9c94; }

label {
  display: block;
  margin: 15px 0 5px;
  color: #b8b8bd;
  font-size: 13px;
}

input, select {
  display: block;
  width: 100%;
  min-width: 0;
  margin-top: 7px;
  padding: 12px;
  border: 1px solid #3b3d41;
  border-radius: 9px;
  outline: none;
  background: #151618;
  color: #f5f5f5;
}

input:focus, select:focus { border-color: #b89b61; }

.raster {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 14px;
}

.preisfeld {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 22px;
  padding: 18px;
  border: 1px solid #474033;
  border-radius: 10px;
  background: #24221d;
}

.preisfeld strong { color: #e5ca91; font-size: 24px; }

.meldung {
  padding: 13px 16px;
  margin-bottom: 18px;
  border-radius: 9px;
}

.meldung.erfolg { background: #183526; color: #a7e6bb; }
.meldung.fehler { background: #401f20; color: #ffb8b2; }

.tabellenbereich { overflow-x: auto; }

table { width: 100%; border-collapse: collapse; font-size: 13px; }
th, td {
  padding: 12px 10px;
  border-bottom: 1px solid #343538;
  text-align: left;
  white-space: nowrap;
}

th { color: #bda775; font-weight: 600; }
td select { width: auto; padding: 7px; margin: 0; }
.aktionen { display: flex; gap: 6px; }
.aktionen button { padding: 7px 9px; }

footer {
  padding: 28px 0 10px;
  color: #777;
  text-align: center;
  font-size: 10px;
  letter-spacing: 2px;
}

@media (max-width: 600px) {
  .app { padding: 22px 12px; }
  .karte, .willkommen { padding: 18px; }
  .raster { grid-template-columns: 1fr; gap: 0; }
  .kopfbereich { gap: 12px; }
  .marke { width: 52px; height: 52px; }
  .willkommen { align-items: flex-start; flex-direction: column; }
}






.bildbereich {
  width: 100%;
  margin: 24px 0;
  overflow: hidden;
  border-radius: 18px;
}

.titelbild {
  display: block;
  width: 100%;
  height: 420px;
  object-fit: cover;
  object-position: center;
}

@media (max-width: 768px) {
  .titelbild {
    height: 240px;
  }
}


.kopfbereich {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 24px;
}

.logo {
  width: 100px;
  height: 100px;
  object-fit: contain;
  flex-shrink: 0;
}

@media (max-width: 600px) {
  .kopfbereich {
    gap: 12px;
  }

  .logo {
    width: 70px;
    height: 70px;
  }
}


.kopfbereich {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
}

.logo {
  width: 85px;
  height: 85px;
  object-fit: contain;
  flex-shrink: 0;
}

/* Banner unter der Überschrift */
.bannerbereich {
  width: 100%;
  margin: 24px 0 32px;
  overflow: hidden;
  border-radius: 16px;
}

.bannerbild {
  display: block;
  width: 100%;
  height: 340px;
  object-fit: cover;
  object-position: center;
}

.kopfbereich {
  position: relative;
  min-height: 380px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20px;
  padding: 40px 24px;
  box-sizing: border-box;

  background-image:
    linear-gradient(
      rgba(0, 0, 0, 0.45),
      rgba(0, 0, 0, 0.60)
    ),
    url('/Dienstag/TUTORIAL/frontend/src/assets/detail.jpeg');

  background-size: cover;
  background-position: center 60%;
  background-repeat: no-repeat;

  border-radius: 18px;
  overflow: hidden;
  text-align: center;
  isolation: isolate;
}
.banner-overlay {
  position: relative;
  z-index: 1;
  width: 100%;
  padding: 30px 20px;
  box-sizing: border-box;

  background: rgba(0, 0, 0, 0.48);
  border-radius: 12px;
}

.kopfbereich h1,
.kopfbereich .eyebrow,
.kopfbereich .untertitel {
  color: #fff;
}

.kopfbereich h1 {
  margin: 12px 0;
}

.kopfbereich .eyebrow {
  letter-spacing: 3px;
}

.kopfbereich .untertitel {
  font-size: 18px;
}

@media (max-width: 600px) {
  .kopfbereich {
    min-height: 280px;
    padding: 20px 12px;
  }

  .banner-overlay {
    padding: 24px 12px;
  }
}

.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 7px 12px;
  border: 1px solid transparent;
  border-radius: 8px;
  font-size: 12px;
  font-weight: 700;
  text-transform: capitalize;
}

/* Abgeschlossen = Grün */
.status-abgeschlossen {
  color: #86efac;
  background: rgba(34, 197, 94, 0.15);
  border-color: rgba(34, 197, 94, 0.4);
}

/* Storniert = Rot */
.status-storniert {
  color: #fca5a5;
  background: rgba(239, 68, 68, 0.15);
  border-color: rgba(239, 68, 68, 0.4);
}

/* Bestätigt = Gelb */
.status-bestätigt {
  color: #fde68a;
  background: rgba(234, 179, 8, 0.15);
  border-color: rgba(234, 179, 8, 0.4);
}

/* Offen = Grau */
.status-offen {
  color: #d1d5db;
  background: rgba(156, 163, 175, 0.12);
  border-color: rgba(156, 163, 175, 0.3);
}

/* Auswahlfeld für Administratoren */
.status-auswahl {
  width: auto;
  min-width: 105px;
  margin: 0;
  padding: 3px 5px;
  border: none;
  background: transparent;
  color: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.status-auswahl option {
  background: #202124;
  color: #fff;
}